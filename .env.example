# ACVEL Licenciado — mobile app environment
# EXPO_PUBLIC_* values are embedded in the app bundle: NEVER put secrets here.
# EAS builds (eas.json profiles development/preview/production) read these from EAS environment variables;
# no production URL is hardcoded in the app. Leave an optional URL empty to hide the feature that uses it.
# (The Firebase web config below is public by design; access is enforced by the backend.)

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# true = in-memory mock backend + mock auth (no network). Forbidden in production builds.
# Keep false to validate against the live ACVEL backend.
EXPO_PUBLIC_USE_MOCKS=false

# ACVEL backend services (base URLs; the app appends /v1/...). No trailing slash needed.
# Live ACVEL services (NestJS). The app appends /v1/... to each base URL.
EXPO_PUBLIC_AUTH_API_URL=https://api-acvel.souaiv.com/api/auth
EXPO_PUBLIC_BUSINESS_API_URL=https://api-acvel.souaiv.com/api/business
EXPO_PUBLIC_RATEIO_API_URL=https://api-acvel.souaiv.com/api/rateio

# Consumer portal (confirmed 2026-10-08): client signup link {url}/auth/cadastro?codigo_representante=<codigo>
# and "Minhas Faturas" {url}/faturas (the portal asks for login; invoice details are never deep-linked).
# Hidden when empty. Homologation/demo builds use https://cliente-test.appacvel.com.br (eas.json preview/development).
EXPO_PUBLIC_CONSUMIDOR_APP_URL=https://cliente.appacvel.com.br

# Licenciado web portal: representative signup link {url}/auth/register/sublicenciado?codigo=<codigo_licenciado>
# (used when the backend has no token invitations, as on the live ACVEL API)
EXPO_PUBLIC_LICENCIADO_WEB_URL=https://licenciado.appacvel.com.br

# Public legal pages: Termos de Uso / Política de Privacidade (opened in the browser; hidden when empty).
# The app never accepts documents on the user's behalf.
# The portal has ONE combined page; when both values are equal the app shows a single
# "Termos de uso e privacidade" link.
EXPO_PUBLIC_TERMS_URL=https://licenciado.appacvel.com.br/termos-de-uso-e-privacidade
EXPO_PUBLIC_PRIVACY_URL=https://licenciado.appacvel.com.br/termos-de-uso-e-privacidade

# Request timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Firebase Authentication (web app config from Firebase Console → Project settings → Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
