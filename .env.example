# ACVEL Licenciado — mobile app environment
# EXPO_PUBLIC_* values are embedded in the app bundle: NEVER put secrets here.
# (The Firebase web config below is public by design; access is enforced by the backend.)

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# true = in-memory mock backend + mock auth (no network). Forbidden in production builds.
# Keep false to validate against the live ACVEL backend.
EXPO_PUBLIC_USE_MOCKS=false

# ACVEL backend services (base URLs; the app appends /v1/...). No trailing slash needed.
# Live ACVEL services (NestJS). The app appends /v1/... to each base URL.
EXPO_PUBLIC_AUTH_API_URL=https://api-acvel.souaiv.com/api/auth
EXPO_PUBLIC_BUSINESS_API_URL=https://api-acvel.souaiv.com/api/business
EXPO_PUBLIC_RATEIO_API_URL=https://api.appacvel.com.br/api/rateio

# Consumer app (client self-registration share link: {url}/auth/cadastro?codigo_representante=...)
EXPO_PUBLIC_CONSUMIDOR_APP_URL=

# Licenciado web portal: representative signup link {url}/auth/register/sublicenciado?codigo=<codigo_licenciado>
# (used when the backend has no token invitations, as on the live ACVEL API)
EXPO_PUBLIC_LICENCIADO_WEB_URL=

# Public legal pages (opened in the browser; the app never accepts documents on the user's behalf)
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Request timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Firebase Authentication (web app config from Firebase Console → Project settings → Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
