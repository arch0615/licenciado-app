{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_CONSUMIDOR_APP_URL": "https://cliente.appacvel.com.br",
        "EXPO_PUBLIC_LICENCIADO_WEB_URL": "https://licenciado.appacvel.com.br",
        "EXPO_PUBLIC_TERMS_URL": "https://licenciado.appacvel.com.br/termos-de-uso-e-privacidade",
        "EXPO_PUBLIC_PRIVACY_URL": "https://licenciado.appacvel.com.br/termos-de-uso-e-privacidade"
      }
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_CONSUMIDOR_APP_URL": "https://cliente-test.appacvel.com.br"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_CONSUMIDOR_APP_URL": "https://cliente-test.appacvel.com.br"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
